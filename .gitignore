# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Output files (keep structure, ignore generated content)
outputs/reports/*
outputs/visuals/*
outputs/simulations/*
outputs/parameter_space/*

# But keep the README files
!outputs/reports/README.md
!outputs/visuals/README.md
!outputs/simulations/README.md
!outputs/parameter_space/README.md

# Keep example files
!outputs/reports/.gitkeep
!outputs/visuals/.gitkeep
!outputs/simulations/.gitkeep
!outputs/parameter_space/.gitkeep

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# Large data files
*.h5
*.hdf5
*.nc
*.dat

# Videos and animations (too large for git)
*.mp4
*.avi
*.mov
*.gif
# Exception: keep small example gifs
!examples/**/*.gif

# Compiled LaTeX
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.toc
